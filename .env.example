# kt-image-forge 环境密钥模板
# 复制此文件为 .env 并填入真实密钥

# gpt-image-2 中转（优先级 1）
KTIF_GPT_IMAGE_BASE_URL=https://your-relay-base-url/v1
KTIF_GPT_IMAGE_API_KEY=sk-your-gpt-image-key

# Agnes Token Plan（优先级 2）
KTIF_AGNES_TOKEN=cpk-your-agnes-token

# Gemini（优先级 3，兜底，可选）
# KTIF_GEMINI_API_KEY=your-gemini-key

# 产品资料根目录
KTIF_PRODUCT_DIR=/path/to/product/files
